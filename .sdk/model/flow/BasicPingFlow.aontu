# BasicPingFlow

main: kit: flow: BasicPingFlow:
{
  entity: "ping",
  kind: "basic",
  name: "BasicPingFlow",
  step: [
    {
      i: {
        ref: "ping_ref01",
        srcdatavar: "ping_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "ping01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ping_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPingFlow"
}