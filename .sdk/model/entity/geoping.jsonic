# Entity: geoping

main: kit: entity: geoping: {

  alias: field: {}

  fields: [
    {
      name: "avg_rtt"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "from_loc"
      req: true
      type: "`$ANY`"
    }
    {
      name: "ip"
      req: true
      type: "`$STRING`"
    }
    {
      name: "is_alive"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "max_rtt"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "min_rtt"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "packet_loss"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "packets_received"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "packets_sent"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "rtt"
      req: true
      type: "`$ARRAY`"
    }
  ]

  name: "geoping"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "ip"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/geoping/{ip}"
          parts: [
            "api"
            "geoping"
            "{id}"
          ]
          rename: {
            param: {
              ip: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
